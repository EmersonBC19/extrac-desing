{
  "name": "code-to-figma-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Pipeline híbrido para convertir código UI (React, Tailwind, CSS) a componentes nativos en Figma con Auto Layout",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:contracts": "npm run build --workspace=@code-to-figma/contracts",
    "build:plugin": "npm run build --workspace=@code-to-figma/plugin",
    "watch:plugin": "npm run watch --workspace=@code-to-figma/plugin",
    "test:send": "npm run test:send --workspace=@code-to-figma/mcp-server",
    "crawl": "npm run crawl --workspace=@code-to-figma/mcp-server --",
    "start:hub": "npm run start:hub --workspace=@code-to-figma/mcp-server",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:live": "vitest run --project live",
    "test:watch": "vitest --project unit",
    "build:extractor": "node scripts/build-extractor.mjs",
    "build:hub-exe": "node scripts/build-hub-exe.mjs",
    "check:generated": "node scripts/build-extractor.mjs --check && node scripts/build-plugin.mjs --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "playwright": "^1.63.0",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^3.10.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1",
    "ws": "^8.23.0"
  }
}
