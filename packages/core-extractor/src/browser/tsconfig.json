{
  // Extractor de navegador: lo empaqueta esbuild (scripts/build-extractor.mjs); tsc solo verifica tipos.
  // Tipado estricto (endurecido en la fase 4.3).
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    // strict activa alwaysStrict, y esbuild lo lee de aquí: añadiría "use strict" y cambiaría la semántica
    // de las funciones declaradas dentro de bloques (extract-node). Se desactiva para no alterar el runtime.
    "alwaysStrict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["./**/*.ts"]
}
