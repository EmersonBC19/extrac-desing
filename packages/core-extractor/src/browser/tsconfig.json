{
  // Extractor de navegador: lo empaqueta esbuild (scripts/build-extractor.mjs); tsc solo verifica tipos.
  // Tipado flexible por ahora (código migrado de JavaScript); se endurece en la fase 4.3.
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": false,
    "noImplicitAny": false,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["./**/*.ts"]
}
