{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "moduleResolution": "node",
    "module": "CommonJS",
    "outDir": "./dist",
    "rootDir": "./src",
    "typeRoots": [
      "../../node_modules/@figma",
      "../../node_modules/@types",
      "./node_modules/@figma",
      "./node_modules/@types"
    ],
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
